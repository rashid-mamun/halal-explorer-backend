{
  "name": "halal-explorer-backend",
  "version": "1.0.0",
  "description": "Halal Explorer Backend API with RBAC",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --testPathPattern=integration",
    "test:integration:run": "node src/__tests__/run-integration-tests.js",
    "test:auth": "jest --testPathPattern=auth",
    "test:middleware": "jest --testPathPattern=middleware",
    "test:services": "jest --testPathPattern=services",
    "test:hotel": "jest --testPathPattern=hotel.integration.test.js",
    "test:activity": "jest --testPathPattern=activity.integration.test.js",
    "test:system": "jest --testPathPattern=system.integration.test.js",
    "test:unit": "jest --testPathPattern=unit",
    "test:unit:run": "node src/__tests__/run-unit-tests.js",
    "test:unit:auth": "jest --testPathPattern=authService.test.js",
    "test:unit:hotel": "jest --testPathPattern=hotelService.test.js",
    "test:unit:cruise": "jest --testPathPattern=src/__tests__/unit/cruise",
    "test:unit:holiday": "jest --testPathPattern=src/__tests__/unit/holiday",
    "test:integration:cruise": "jest --testPathPattern=cruise.integration.test.js",
    "test:integration:holiday": "jest --testPathPattern=holiday.integration.test.js",
    "test:unit:middleware": "jest --testPathPattern=auth.test.js",
    "test:unit:validators": "jest --testPathPattern=validators.test.js",
    "test:all": "node src/__tests__/run-all-tests.js",
    "test:all:unit": "npm run test:unit:run",
    "test:all:integration": "npm run test:integration:run"
  },
  "keywords": [
    "halal",
    "travel",
    "api",
    "rbac",
    "authentication",
    "authorization"
  ],
  "author": "Halal Explorer Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.11.0",
    "bcrypt": "^5.1.0",
    "body-parser": "^1.20.2",
    "btoa": "^1.2.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "helmet": "^7.0.0",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.5.0",
    "multer": "^1.4.5-lts.1",
    "node-cache": "^5.1.2",
    "uuid": "^11.1.0",
    "validator": "^13.15.15"
  },
  "devDependencies": {
    "jest": "^29.6.2",
    "mongodb-memory-server": "^10.1.4",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  }
}
